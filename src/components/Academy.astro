---
// Academy section component (Refactored)
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const courses = await getCollection('cursos'); // Fetch all courses

const categoryColors = { // Colors for badges
    civil: 'bg-brick-500',
    sistemas: 'bg-blue-600',
    minas: 'bg-yellow-600',
    software: 'bg-emerald-600',
};
---

<section id="academia" class="py-20 bg-navy-900 text-white relative">
    <!-- Decorative Background Elements -->
    <div class="absolute top-0 right-0 p-12 opacity-5">
        <i class="fa-solid fa-drafting-compass text-9xl"></i>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
            <div class="max-w-2xl">
                <span class="text-brick-500 font-bold tracking-wider uppercase mb-2 block">Academia de Ingeniería</span>
                <h2 class="text-3xl lg:text-4xl font-bold mb-4">Especialízate con Nosotros</h2>
                <p class="text-gray-300">
                    Cursos prácticos dictados por ingenieros colegiados con experiencia en campo. Potencia tu perfil profesional.
                </p>
            </div>
            
            <!-- Filters -->
            <div class="flex flex-wrap gap-2" id="course-filters">
                <button class="filter-btn active px-4 py-2 rounded-full border border-brick-500 bg-brick-500 text-white text-sm font-bold transition-all" data-filter="all">Todos</button>
                <button class="filter-btn px-4 py-2 rounded-full border border-gray-600 hover:border-emerald-500 hover:text-emerald-500 text-gray-300 text-sm font-bold transition-all" data-filter="software">Software / Dev</button>
                <button class="filter-btn px-4 py-2 rounded-full border border-gray-600 hover:border-blue-500 hover:text-blue-500 text-gray-300 text-sm font-bold transition-all" data-filter="sistemas">Sistemas / IA</button>
                <button class="filter-btn px-4 py-2 rounded-full border border-gray-600 hover:border-brick-500 hover:text-brick-500 text-gray-300 text-sm font-bold transition-all" data-filter="civil">Civil</button>
                <button class="filter-btn px-4 py-2 rounded-full border border-gray-600 hover:border-yellow-500 hover:text-yellow-500 text-gray-300 text-sm font-bold transition-all" data-filter="minas">Minas</button>
            </div>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="courses-grid">
            {courses.map((course) => (
                <div class={`course-card bg-navy-800 rounded-lg overflow-hidden shadow-lg hover:shadow-brick-500/20 transition-all hover:-translate-y-1 group border border-navy-700`} data-category={course.data.category}>
                    <div class="h-48 bg-gray-700 relative overflow-hidden">
                        <Image src={course.data.image as any} alt={course.data.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
                        <div class="absolute inset-0 bg-gradient-to-t from-navy-900 to-transparent opacity-90"></div>
                        <div class="absolute bottom-4 left-4">
                            <span class={`${categoryColors[course.data.category]} text-xs font-bold px-2 py-1 rounded text-white uppercase`}>
                                {course.data.category}
                            </span>
                        </div>
                    </div>
                    <div class="p-6">
                        <h3 class="font-bold text-lg mb-2 leading-tight group-hover:text-brick-500 transition-colors line-clamp-2 min-h-[3.5rem]">
                            {course.data.title}
                        </h3>
                        <p class="text-sm text-gray-400 mb-4 line-clamp-2">
                            {course.data.description}
                        </p>
                        <a href={`/cursos/${course.slug}`} class="block w-full py-2 border border-gray-600 rounded text-sm text-center hover:bg-white hover:text-navy-900 transition-colors font-medium">
                            Ver Temario
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
    // Simple Client-side filtering
    const filterBtns = document.querySelectorAll('.filter-btn');
    const courseCards = document.querySelectorAll('.course-card');

    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            // Remove active class from all
            filterBtns.forEach(b => {
                b.classList.remove('bg-brick-500', 'text-white', 'border-brick-500');
                b.classList.add('border-gray-600', 'text-gray-300');
            });
            // Add active to clicked
            btn.classList.remove('border-gray-600', 'text-gray-300');
            // Assuming the active state style matches the 'Todos' initial style or logic
             // But for specific categories I might want different active colors? 
             // For simplicity sticking to the "primary" active style for all for now, 
             // or I can match the hover color. Let's stick to brick-500 for active state uniformity
             btn.classList.add('bg-brick-500', 'text-white', 'border-brick-500');

            const filterValue = btn.getAttribute('data-filter');

            courseCards.forEach(card => {
                if (filterValue === 'all' || card.getAttribute('data-category') === filterValue) {
                    card.classList.remove('hidden');
                    card.classList.add('block'); // Ensure block
                } else {
                    card.classList.add('hidden');
                    card.classList.remove('block');
                }
            });
        });
    });
</script>

---
// Navbar sticky component - Constructora Salcedo CSIC
---

<nav
    class="sticky top-0 z-50 bg-navy-900 text-white shadow-lg transition-all duration-300 border-b border-navy-800"
>
    <div class="container mx-auto px-6 py-3.5 flex justify-between items-center">
        <!-- Logo -->
        <a
            href="/"
            class="text-2xl font-bold tracking-wider flex items-center gap-3 text-white"
        >
            <img src="/images/logo.png" alt="Constructora Salcedo CSIC Logo" class="h-12 w-auto" />
            <div class="hidden sm:flex flex-col">
                <span class="leading-none text-base font-extrabold tracking-wider">CONSTRUCTORA <span class="text-brick-500">SALCEDO</span></span>
                <span class="text-[10px] text-gray-300 font-normal tracking-widest uppercase">E Ingenieros Consultores E.I.R.L. "CSIC"</span>
            </div>
        </a>

        <!-- Desktop Menu -->
        <div class="hidden lg:flex items-center space-x-7 font-medium text-sm">
            <a href="/#inicio" class="hover:text-brick-500 transition-colors"
                >Inicio</a
            >
            <a href="/#servicios" class="hover:text-brick-500 transition-colors"
                >Servicios Obra</a
            >
            <a href="/reservar" class="text-brick-500 font-bold hover:text-white transition-colors flex items-center gap-1.5"
                ><i class="fa-solid fa-calendar-check text-brick-500"></i> Reservar Consulta</a
            >
            <a href="/#academia" class="hover:text-brick-500 transition-colors"
                >Academia Cursos</a
            >
            <a href="/admin/reservas" class="text-emerald-400 font-semibold hover:text-white transition-colors flex items-center gap-1.5"
                ><i class="fa-solid fa-user-shield text-xs"></i> Gestión CSIC</a
            >
            <a href="/#contacto" class="hover:text-brick-500 transition-colors"
                >Contacto</a
            >
        </div>

        <!-- Right User / CTA Action Buttons -->
        <div class="hidden md:flex items-center gap-3">
            <a 
                href="/login" 
                class="text-sm font-semibold text-gray-200 hover:text-white border border-gray-700 hover:border-gray-500 px-4 py-2 rounded-lg transition-colors"
            >
                <i class="fa-solid fa-user mr-1.5 text-brick-500"></i> Acceso
            </a>
            
            <a
                href="/reservar"
                class="inline-flex items-center gap-2 bg-brick-500 hover:bg-brick-600 text-white px-4 py-2 rounded-lg font-bold text-sm transition-transform transform hover:scale-105 shadow-md"
            >
                <i class="fa-solid fa-calendar-days text-sm"></i>
                Agendar Cita
            </a>
        </div>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="lg:hidden text-2xl focus:outline-none">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <!-- Mobile Menu Container -->
    <div id="mobile-menu" class="hidden lg:hidden bg-navy-900 border-t border-navy-800">
        <div class="container mx-auto px-6 py-4 flex flex-col space-y-4 text-sm">
            <a href="/#inicio" class="mobile-link hover:text-brick-500 transition-colors">Inicio</a>
            <a href="/#servicios" class="mobile-link hover:text-brick-500 transition-colors">Servicios Obra</a>
            <a href="/reservar" class="mobile-link text-brick-500 font-bold">
                <i class="fa-solid fa-calendar-check mr-2"></i>Reservar Consulta Técnica
            </a>
            <a href="/#academia" class="mobile-link hover:text-brick-500 transition-colors">Academia Cursos</a>
            <a href="/admin/reservas" class="mobile-link text-emerald-400 font-bold">
                <i class="fa-solid fa-user-shield mr-2"></i>Gestión CSIC (Admin)
            </a>
            <a href="/login" class="mobile-link hover:text-brick-500 transition-colors">
                <i class="fa-solid fa-user mr-2"></i>Iniciar Sesión / Registro
            </a>
            <a href="https://wa.me/51977715469" target="_blank" class="text-green-400 font-semibold">
                <i class="fa-brands fa-whatsapp mr-2"></i>WhatsApp Directo
            </a>
        </div>
    </div>
</nav>

<script>
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');

    if (mobileMenuBtn && mobileMenu) {
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Close menu when a link is clicked
        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });
    }
</script>

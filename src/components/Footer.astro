---
// Footer component - Constructora Salcedo
---

<footer
    id="contacto"
    class="bg-navy-900 text-white pt-16 pb-8 border-t border-navy-800"
>
    <div class="container mx-auto px-6">
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
            <!-- Brand -->
            <div>
                <div class="flex items-center gap-3 text-xl font-bold mb-6">
                    <img src="/images/logo.png" alt="Constructora Salcedo" class="h-14 w-auto" />
                </div>
                <p class="text-gray-400 text-sm mb-6 leading-relaxed">
                    Ingeniería sólida, obras civiles de calidad y capacitación especializada en el corazón de Apurímac.
                </p>
                <div class="flex space-x-4">
                    <a
                        href="#"
                        class="w-10 h-10 rounded-full bg-navy-800 flex items-center justify-center hover:bg-brick-500 transition-colors"
                        ><i class="fa-brands fa-facebook-f"></i></a
                    >
                    <a
                        href="#"
                        class="w-10 h-10 rounded-full bg-navy-800 flex items-center justify-center hover:bg-brick-500 transition-colors"
                        ><i class="fa-brands fa-linkedin-in"></i></a
                    >
                    <a
                        href="#"
                        class="w-10 h-10 rounded-full bg-navy-800 flex items-center justify-center hover:bg-brick-500 transition-colors"
                        ><i class="fa-brands fa-instagram"></i></a
                    >
                </div>
            </div>

            <!-- Quick Links -->
            <div>
                <h4
                    class="text-lg font-bold mb-6 border-b border-navy-800 pb-2 inline-block text-brick-500"
                >
                    Enlaces Rápidos
                </h4>
                <ul class="space-y-3 text-gray-400 text-sm">
                    <li>
                        <a
                            href="/#inicio"
                            class="hover:text-brick-500 transition-colors"
                            >Inicio</a>
                    </li>
                    <li>
                        <a
                            href="/#servicios"
                            class="hover:text-brick-500 transition-colors"
                            >Servicios de Obra</a>
                    </li>
                    <li>
                        <a
                            href="/#academia"
                            class="hover:text-brick-500 transition-colors"
                            >Academia de Cursos</a>
                    </li>
                    <li>
                        <a
                            href="/#nosotros"
                            class="hover:text-brick-500 transition-colors"
                            >Nosotros</a>
                    </li>
                </ul>
            </div>

            <!-- Contact -->
            <div>
                <h4
                    class="text-lg font-bold mb-6 border-b border-navy-800 pb-2 inline-block text-brick-500"
                >
                    Contacto
                </h4>
                <ul class="space-y-4 text-gray-400 text-sm">
                    <li class="flex items-start gap-3">
                        <i class="fa-solid fa-location-dot text-brick-500 mt-1"
                        ></i>
                        <span>Av. Principal 123, Abancay, Apurímac, Perú</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <i class="fa-solid fa-phone text-brick-500"></i>
                        <span>+51 977 715 469</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <i class="fa-solid fa-envelope text-brick-500"></i>
                        <span>contacto@constructorasalcedo.com</span>
                    </li>
                </ul>
            </div>

            <!-- CTA -->
            <div>
                <h4
                    class="text-lg font-bold mb-6 border-b border-navy-800 pb-2 inline-block text-brick-500"
                >
                    ¿Tienes una Obra o Consulta?
                </h4>
                <p class="text-gray-400 text-sm mb-4">
                    Escríbenos para una cotización o informes sobre nuestros cursos.
                </p>
                <a
                    href="https://wa.me/51977715469"
                    class="block w-full bg-brick-500 hover:bg-brick-600 text-white text-center py-3 rounded font-bold transition-colors shadow-lg"
                >
                    <i class="fa-brands fa-whatsapp mr-2"></i> Chatear por WhatsApp
                </a>
            </div>
        </div>

        <div
            class="border-t border-navy-800 pt-8 text-center text-gray-500 text-sm"
        >
            <p>
                &copy; 2026 Constructora Salcedo e Ingenieros Consultores E.I.R.L. Todos los derechos reservados.
            </p>
        </div>
    </div>
</footer>
